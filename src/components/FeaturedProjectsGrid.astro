---
import { FEATURED_PROJECTS } from '../domain/portfolio-data';
---

<section id="projects" class="border-b border-neutral-800">
  <div class="max-w-6xl mx-auto border-x border-neutral-800">
    <!-- Section Blueprint Header -->
    <div class="p-6 sm:p-10 border-b border-neutral-800 bg-[#0B0B0B] flex flex-col md:flex-row md:items-end justify-between gap-6 relative">
      <span class="hidden sm:block absolute top-3 right-3 font-mono text-xs text-neutral-700 select-none">+</span>
      <div>
        <div class="text-xs font-mono uppercase tracking-wider text-[#FF4F00]">
          [01 // PRODUCTION SYSTEMS &amp; ARCHITECTURAL DECISIONS]
        </div>
        <h2 class="text-2xl sm:text-4xl font-bold tracking-tight text-[#EDEDED] mt-2">
          Engineered Systems &amp; Specifications
        </h2>
      </div>
      <p class="text-xs sm:text-sm font-mono text-neutral-400 max-w-md leading-relaxed">
        4 production repositories engineered with Hexagonal Architecture, SOLID ports, automated test suites, and deterministic Docker topologies.
      </p>
    </div>

    <!-- Ecosystem Interoperability Strip -->
    <div class="px-6 py-3.5 border-b border-neutral-800 bg-[#0E0E0E] flex flex-wrap items-center justify-between gap-3 text-[11px] font-mono">
      <span class="text-[#FF4F00] uppercase font-bold">SYSTEM TOPOLOGY //</span>
      <div class="flex flex-wrap items-center gap-2 text-neutral-300">
        <span class="px-2 py-0.5 bg-[#141414] border border-neutral-800">LLM Host (Claude / IDE)</span>
        <span class="text-neutral-600">--[stdio JSON-RPC]--&gt;</span>
        <span class="px-2 py-0.5 bg-[#141414] border border-neutral-800 text-[#EDEDED]">yugi-mcp (22 Tools)</span>
        <span class="text-neutral-600">--[5 ISP Ports]--&gt;</span>
        <span class="px-2 py-0.5 bg-[#141414] border border-neutral-800 text-[#EDEDED]">yugioh-ts-ddd (512-D CLIP)</span>
        <span class="text-neutral-600">+</span>
        <span class="px-2 py-0.5 bg-[#141414] border border-neutral-800 text-[#EDEDED]">card-analysis (RoBERTa)</span>
      </div>
    </div>

    <!-- 2x2 Exposed Hairline Blueprint Grid -->
    <div class="grid md:grid-cols-2 divide-y divide-neutral-800">
      {FEATURED_PROJECTS.map((project, index) => (
        <article
          class={`p-6 sm:p-8 lg:p-10 bg-[#090909] hover:bg-[#0C0C0C] transition-colors flex flex-col justify-between relative ${
            index % 2 === 0 ? 'md:border-r md:border-neutral-800' : ''
          } ${index < 2 ? 'md:border-b md:border-neutral-800' : ''}`}
        >
          <span class="hidden sm:block absolute top-3 right-3 font-mono text-xs text-neutral-700 select-none">+</span>

          <div class="space-y-5">
            <!-- System Code & Badge -->
            <div class="flex flex-wrap items-center justify-between gap-2 pr-4">
              <span class="text-xs font-mono font-bold text-[#FF4F00]">
                {project.systemCode}
              </span>
              <span class="px-2 py-0.5 bg-[#121212] border border-neutral-800 text-[10px] font-mono text-neutral-300 tracking-wider">
                {project.categoryBadge}
              </span>
            </div>

            <!-- Title & Subtitle -->
            <div>
              <h3 class="text-xl sm:text-2xl font-bold text-[#EDEDED] font-mono tracking-tight">
                <a
                  href={project.repositoryUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="hover:text-[#FF4F00] transition-colors inline-flex items-center gap-2"
                >
                  <span>{project.title}</span>
                  <svg class="w-4 h-4 text-neutral-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M7 17L17 7M17 7H7M17 7V17" />
                  </svg>
                </a>
              </h3>
              <p class="text-xs sm:text-sm text-neutral-400 mt-1 leading-snug">
                {project.subtitle}
              </p>
            </div>

            <!-- Tabular Metrics Bar -->
            <div class="grid grid-cols-2 sm:grid-cols-4 border border-neutral-800 bg-[#0D0D0D] divide-x divide-y sm:divide-y-0 divide-neutral-800 tabular-nums">
              {project.metrics.map((metric) => (
                <div class="px-3 py-2.5">
                  <div class="text-xs font-mono font-bold text-[#EDEDED]">{metric.value}</div>
                  <div class="text-[10px] font-mono text-neutral-500 uppercase truncate mt-0.5">
                    {metric.label}
                  </div>
                </div>
              ))}
            </div>

            <!-- Dataflow Pipeline Spec -->
            <div class="p-3 bg-[#0D0D0D] border border-neutral-800/90 font-mono text-[11px] text-neutral-400 leading-relaxed">
              <span class="text-neutral-200 font-bold">PIPELINE:</span> {project.architectureTopology}
            </div>

            <!-- Problem & Architectural Decision Record (ADR) -->
            <div class="space-y-3 text-xs leading-relaxed">
              <div class="text-neutral-300">
                <span class="font-mono text-[11px] uppercase text-neutral-500 block mb-0.5">
                  // DOMAIN CHALLENGE
                </span>
                {project.problemSolved}
              </div>

              <div class="border-l-2 border-[#FF4F00] pl-3.5 py-0.5 text-neutral-200">
                <span class="font-mono text-[11px] uppercase text-[#FF4F00] font-bold block mb-0.5">
                  // ARCHITECTURAL DECISION RECORD (ADR)
                </span>
                {project.architecturalDecision}
              </div>
            </div>

            <!-- Tech Stack Tags -->
            <div class="flex flex-wrap gap-1.5 pt-1">
              {project.techTags.map((tag) => (
                <span class="px-2.5 py-1 bg-[#111111] text-neutral-300 text-[11px] font-mono border border-neutral-800">
                  {tag}
                </span>
              ))}
            </div>
          </div>

          <!-- Footer Actions -->
          <div class="mt-7 pt-4 border-t border-neutral-800 flex flex-wrap items-center justify-between gap-3">
            <code class="text-[11px] font-mono text-neutral-400 bg-[#0D0D0D] px-2.5 py-1.5 border border-neutral-800">
              $ {project.quickstartCommand}
            </code>

            <div class="flex items-center gap-2">
              {project.playgroundMode && (
                <a
                  href="#playground"
                  data-playground-mode={project.playgroundMode}
                  class="px-3 py-1.5 bg-[#141414] hover:border-[#FF4F00] text-[#EDEDED] border border-neutral-700 text-xs font-mono transition-colors inline-flex items-center gap-1.5"
                >
                  <span class="w-1.5 h-1.5 bg-[#FF4F00]"></span>
                  <span>SANDBOX</span>
                </a>
              )}
              <a
                href={project.repositoryUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="px-3.5 py-1.5 bg-[#EDEDED] hover:bg-[#FF4F00] text-[#090909] text-xs font-mono font-bold transition-colors inline-flex items-center gap-1"
              >
                <span>SOURCE</span>
                <span>↗</span>
              </a>
            </div>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
