---
import { FEATURED_PROJECTS } from '../domain/portfolio-data';
---

<section id="projects" class="py-20 border-b border-slate-800/70">
  <div class="max-w-6xl mx-auto px-4 sm:px-6">
    <div class="flex flex-col md:flex-row md:items-end justify-between mb-12 gap-4">
      <div>
        <span class="text-xs font-mono uppercase tracking-widest text-sky-400">Production Architecture</span>
        <h2 class="text-3xl sm:text-4xl font-bold text-white mt-1">
          Featured Engineering Projects
        </h2>
      </div>
      <p class="text-sm text-slate-400 max-w-md">
        4 interconnected repositories engineered with Clean Architecture, SOLID principles, automated test suites, and single-command Docker deployments.
      </p>
    </div>

    <div class="grid md:grid-cols-2 gap-6">
      {FEATURED_PROJECTS.map((project, index) => (
        <article class="flex flex-col justify-between rounded-2xl bg-slate-900/80 border border-slate-800/90 hover:border-sky-500/50 p-6 shadow-xl transition-all">
          <div>
            <!-- Top Badge & Index -->
            <div class="flex items-center justify-between gap-2 mb-4">
              <span class="px-2.5 py-1 rounded-md bg-sky-500/10 border border-sky-500/30 text-sky-300 text-xs font-mono">
                {project.categoryBadge}
              </span>
              <span class="text-xs font-mono text-slate-500">0{index + 1} / 04</span>
            </div>

            <!-- Title & Subtitle -->
            <h3 class="text-xl font-bold text-white font-mono">
              <a
                href={project.repositoryUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="hover:text-sky-400 transition-colors"
              >
                {project.title} ↗
              </a>
            </h3>
            <p class="text-sm text-slate-300 font-medium mt-1">{project.subtitle}</p>

            <!-- Key Metrics Grid -->
            <div class="grid grid-cols-2 sm:grid-cols-4 gap-2 my-5">
              {project.metrics.map((metric) => (
                <div class="rounded-lg bg-slate-950/80 border border-slate-800/80 px-3 py-2">
                  <div class="text-xs font-mono font-bold text-emerald-400">{metric.value}</div>
                  <div class="text-[11px] text-slate-400 truncate">{metric.label}</div>
                </div>
              ))}
            </div>

            <!-- Problem & Architectural Trade-off (ADR) -->
            <div class="space-y-2.5 text-xs text-slate-300 leading-relaxed bg-slate-950/50 rounded-xl p-4 border border-slate-800/60">
              <p>
                <strong class="text-slate-100 font-semibold">Problem Solved:</strong> {project.problemSolved}
              </p>
              <p>
                <strong class="text-sky-300 font-semibold">Architectural ADR:</strong> {project.architecturalDecision}
              </p>
            </div>

            <!-- Tech Stack Pills -->
            <div class="flex flex-wrap gap-1.5 mt-4">
              {project.techTags.map((tag) => (
                <span class="px-2.5 py-1 rounded-full bg-slate-800/90 text-slate-200 text-[11px] font-mono border border-slate-700/70">
                  {tag}
                </span>
              ))}
            </div>
          </div>

          <!-- Footer Actions -->
          <div class="mt-6 pt-4 border-t border-slate-800/80 flex flex-wrap items-center justify-between gap-3">
            <code class="text-[11px] font-mono text-slate-400 bg-slate-950 px-2.5 py-1 rounded border border-slate-800">
              $ {project.quickstartCommand}
            </code>

            <div class="flex items-center gap-2.5">
              {project.playgroundMode && (
                <a
                  href={`#playground`}
                  data-playground-mode={project.playgroundMode}
                  class="px-3 py-1.5 rounded-lg bg-purple-500/15 hover:bg-purple-500/25 text-purple-300 border border-purple-500/30 text-xs font-mono transition-colors"
                >
                  ⚡ Live Demo ↓
                </a>
              )}
              <a
                href={project.repositoryUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="px-3.5 py-1.5 rounded-lg bg-sky-500/15 hover:bg-sky-500/25 text-sky-300 border border-sky-500/30 text-xs font-mono font-semibold transition-colors"
              >
                GitHub Repo ↗
              </a>
            </div>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
