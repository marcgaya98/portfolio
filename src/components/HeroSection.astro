---
import { DEVELOPER_PROFILE } from '../domain/portfolio-data';
---

<section id="top" class="relative pt-14 pb-20 sm:pt-20 sm:pb-24 border-b border-slate-800/70">
  <div class="max-w-6xl mx-auto px-4 sm:px-6">
    <!-- Status Pill -->
    <div class="inline-flex items-center gap-2.5 px-3.5 py-1.5 rounded-full bg-emerald-500/10 border border-emerald-500/30 text-emerald-300 text-xs font-mono mb-6">
      <span class="w-2 h-2 rounded-full bg-emerald-400 animate-ping"></span>
      <span>{DEVELOPER_PROFILE.availabilityStatus}</span>
    </div>

    <div class="grid lg:grid-cols-12 gap-10 items-center">
      <div class="lg:col-span-8 space-y-6">
        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold tracking-tight text-white leading-[1.12]">
          {DEVELOPER_PROFILE.fullName}
          <span class="block mt-2 bg-gradient-to-r from-sky-400 via-indigo-400 to-purple-400 bg-clip-text text-transparent">
            {DEVELOPER_PROFILE.headline}
          </span>
        </h1>

        <p class="text-base sm:text-lg text-slate-300 leading-relaxed max-w-2xl">
          {DEVELOPER_PROFILE.subheadline}
        </p>

        <!-- Primary Action Buttons (GitHub, LinkedIn, Live Playground) -->
        <div class="flex flex-wrap items-center gap-3.5 pt-2">
          <a
            href={DEVELOPER_PROFILE.githubUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 px-5 py-3 rounded-xl bg-white text-slate-950 hover:bg-slate-200 font-semibold text-sm shadow-lg shadow-white/10 transition-all"
          >
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor">
              <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z" />
            </svg>
            GitHub Profile
          </a>

          <a
            href={DEVELOPER_PROFILE.linkedinUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 px-5 py-3 rounded-xl bg-[#0A66C2] hover:bg-[#0958a8] text-white font-semibold text-sm shadow-lg shadow-blue-500/20 transition-all"
          >
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor">
              <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z" />
            </svg>
            LinkedIn
          </a>

          <a
            href="#playground"
            class="inline-flex items-center gap-2 px-5 py-3 rounded-xl bg-slate-800/90 hover:bg-slate-700 text-sky-300 border border-sky-500/30 font-mono text-sm transition-all"
          >
            ⚡ Try Interactive API Playground
          </a>
        </div>
      </div>

      <!-- Dual CV Download Card (AI Track & Backend Track) -->
      <div class="lg:col-span-4 bg-slate-900/90 border border-slate-800 rounded-2xl p-5 shadow-2xl space-y-4">
        <div class="flex items-center justify-between border-b border-slate-800 pb-3">
          <div>
            <span class="text-xs font-mono uppercase tracking-wider text-sky-400">Tailored Resumes (PDF)</span>
            <h2 class="text-sm font-bold text-white mt-0.5">Select Role Track CV</h2>
          </div>
          <span class="px-2 py-0.5 rounded bg-slate-800 text-[11px] font-mono text-slate-300">2 Tracks</span>
        </div>

        <div class="space-y-3">
          {DEVELOPER_PROFILE.cvs.map((cv) => (
            <a
              href={cv.filePath}
              download
              class="block p-3.5 rounded-xl bg-slate-800/60 hover:bg-slate-800 border border-slate-700/70 hover:border-sky-500/50 transition-all group"
            >
              <div class="flex items-center justify-between">
                <span class="text-sm font-semibold text-white group-hover:text-sky-300 transition-colors">
                  📄 {cv.label}
                </span>
                <span class="text-xs font-mono text-sky-400 group-hover:translate-x-0.5 transition-transform">
                  PDF ↓
                </span>
              </div>
              <div class="mt-1 text-[11px] font-mono text-purple-300">{cv.badge}</div>
              <p class="mt-1 text-xs text-slate-400 leading-snug">{cv.focusSummary}</p>
            </a>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>
