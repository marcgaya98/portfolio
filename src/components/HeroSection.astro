---
import { DEVELOPER_PROFILE } from '../domain/portfolio-data';
---

<section id="top" class="border-b border-neutral-800">
  <div class="max-w-6xl mx-auto border-x border-neutral-800 relative">
    <!-- Top Blueprint Telemetry Bar -->
    <div class="border-b border-neutral-800 px-4 sm:px-6 py-2.5 bg-[#0C0C0C] flex flex-wrap items-center justify-between gap-3 text-[11px] font-mono">
      <div class="flex items-center gap-2.5 text-neutral-200">
        <span class="w-2 h-2 bg-[#FF4F00] inline-block animate-pulse"></span>
        <span>{DEVELOPER_PROFILE.availabilityStatus}</span>
      </div>
      <div class="flex items-center gap-4 text-neutral-400 tabular-nums">
        <span>LOC: {DEVELOPER_PROFILE.location}</span>
        <span class="hidden sm:inline text-neutral-700">|</span>
        <span class="hidden sm:inline text-neutral-300">VERIFIED: 4 SYSTEMS // 78 TESTS PASS</span>
      </div>
    </div>

    <!-- Main 12-Column Blueprint Grid -->
    <div class="grid lg:grid-cols-12 divide-y lg:divide-y-0 lg:divide-x divide-neutral-800">
      <!-- Left 8 Columns: Executive Specification -->
      <div class="lg:col-span-8 p-6 sm:p-10 lg:p-12 blueprint-bg flex flex-col justify-between space-y-8 relative">
        <!-- Corner Crosshair Marker -->
        <span class="hidden sm:block absolute top-3 right-3 font-mono text-xs text-neutral-700 select-none">+</span>

        <div class="space-y-5">
          <div class="inline-flex items-center gap-2 text-xs font-mono text-[#FF4F00] uppercase tracking-wider">
            <span>[00 // EXECUTIVE BRIEF &amp; SYSTEM ARCHITECTURE]</span>
          </div>

          <h1 class="text-4xl sm:text-5xl lg:text-[54px] font-bold tracking-tight text-[#EDEDED] leading-[1.06]">
            {DEVELOPER_PROFILE.fullName}
            <span class="block mt-2 text-neutral-400 font-normal text-2xl sm:text-3xl lg:text-4xl tracking-tight">
              {DEVELOPER_PROFILE.headline}
            </span>
          </h1>

          <p class="text-sm sm:text-base text-neutral-300 leading-relaxed max-w-2xl">
            {DEVELOPER_PROFILE.subheadline}
          </p>
        </div>

        <div class="space-y-6">
          <!-- 4-Cell Tabular System Telemetry Strip -->
          <div class="grid grid-cols-2 sm:grid-cols-4 border border-neutral-800 bg-[#090909] divide-x divide-y sm:divide-y-0 divide-neutral-800 tabular-nums">
            <div class="p-3.5">
              <div class="text-xs font-mono text-[#FF4F00] font-bold">07 CONTEXTS</div>
              <div class="text-[11px] font-mono text-neutral-400 mt-0.5">Hexagonal DDD Core</div>
            </div>
            <div class="p-3.5">
              <div class="text-xs font-mono text-[#EDEDED] font-bold">22 MCP TOOLS</div>
              <div class="text-[11px] font-mono text-neutral-400 mt-0.5">JSON-RPC 2.0 stdio</div>
            </div>
            <div class="p-3.5">
              <div class="text-xs font-mono text-[#EDEDED] font-bold">&lt;12ms CLIP</div>
              <div class="text-[11px] font-mono text-neutral-400 mt-0.5">512-D Vector Search</div>
            </div>
            <div class="p-3.5">
              <div class="text-xs font-mono text-[#EDEDED] font-bold">18.2ms NLP</div>
              <div class="text-[11px] font-mono text-neutral-400 mt-0.5">125M RoBERTa PyTorch</div>
            </div>
          </div>

          <!-- Primary Action Controls -->
          <div class="flex flex-wrap items-center gap-3">
            <a
              href={DEVELOPER_PROFILE.githubUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2.5 px-5 py-3 bg-[#EDEDED] hover:bg-[#FF4F00] text-[#090909] font-mono font-bold text-xs tracking-wide transition-colors"
            >
              <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor">
                <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z" />
              </svg>
              <span>GITHUB // @MARCGAYA98</span>
            </a>

            <a
              href={DEVELOPER_PROFILE.linkedinUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2.5 px-5 py-3 bg-[#0E0E0E] hover:bg-neutral-800 text-[#EDEDED] border border-neutral-700 font-mono font-medium text-xs tracking-wide transition-colors"
            >
              <svg class="w-3.5 h-3.5 text-neutral-300" viewBox="0 0 24 24" fill="currentColor">
                <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z" />
              </svg>
              <span>LINKEDIN PROFILE</span>
            </a>

            <a
              href="#playground"
              class="inline-flex items-center gap-2 px-5 py-3 bg-[#141414] hover:border-[#FF4F00] text-[#EDEDED] border border-neutral-800 font-mono text-xs transition-colors"
            >
              <span class="w-1.5 h-1.5 bg-[#FF4F00]"></span>
              <span>LAUNCH API SANDBOX</span>
              <span class="text-neutral-500">-&gt;</span>
            </a>
          </div>
        </div>
      </div>

      <!-- Right 4 Columns: Technical Datasheet for Dual CV Tracks -->
      <div class="lg:col-span-4 bg-[#0B0B0B] flex flex-col justify-between divide-y divide-neutral-800">
        <div class="p-6 bg-[#0E0E0E]">
          <div class="flex items-center justify-between">
            <span class="text-[11px] font-mono uppercase tracking-wider text-[#FF4F00]">
              DOC.SPEC // RESUMES
            </span>
            <span class="px-2 py-0.5 bg-[#141414] border border-neutral-800 text-[10px] font-mono text-neutral-300">
              2 TRACKS • PDF
            </span>
          </div>
          <h2 class="text-base font-bold text-[#EDEDED] mt-1.5">
            Tailored Engineering CVs
          </h2>
          <p class="text-xs text-neutral-400 mt-1">
            Select the technical specification aligned with your engineering team:
          </p>
        </div>

        <div class="divide-y divide-neutral-800 flex-1 flex flex-col">
          {DEVELOPER_PROFILE.cvs.map((cv) => (
            <a
              href={cv.filePath}
              download
              class="p-6 bg-[#090909] hover:bg-[#111111] transition-colors group flex-1 flex flex-col justify-between"
            >
              <div>
                <div class="flex items-center justify-between text-[11px] font-mono text-neutral-400 mb-2">
                  <span class="text-[#FF4F00]">{cv.code}</span>
                  <span class="inline-flex items-center gap-1 text-neutral-300 group-hover:text-[#FF4F00] transition-colors">
                    <span>DOWNLOAD PDF</span>
                    <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                      <path d="M12 3v12m0 0l-4-4m4 4l4-4M4 17v2a2 2 0 002 2h12a2 2 0 002-2v-2" />
                    </svg>
                  </span>
                </div>

                <div class="text-sm font-bold text-[#EDEDED] group-hover:text-white transition-colors">
                  {cv.label}
                </div>

                <div class="mt-2 inline-block px-2 py-0.5 bg-[#141414] border border-neutral-800 text-[11px] font-mono text-neutral-300">
                  {cv.badge}
                </div>
              </div>

              <p class="mt-3 text-xs text-neutral-400 leading-relaxed">
                {cv.focusSummary}
              </p>
            </a>
          ))}
        </div>

        <div class="px-6 py-3 bg-[#0C0C0C] text-[11px] font-mono text-neutral-500 flex items-center justify-between">
          <span>DIRECT: {DEVELOPER_PROFILE.email}</span>
          <span>{DEVELOPER_PROFILE.phoneFormatted}</span>
        </div>
      </div>
    </div>
  </div>
</section>
