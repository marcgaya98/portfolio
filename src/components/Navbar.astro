---
import { DEVELOPER_PROFILE } from '../domain/portfolio-data';
---

<header class="sticky top-0 z-50 backdrop-blur-md bg-[#090d16]/80 border-b border-slate-800/80">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 h-16 flex items-center justify-between">
    <a href="#top" class="flex items-center gap-2.5 group">
      <span class="w-8 h-8 rounded-lg bg-gradient-to-br from-sky-500 to-purple-600 flex items-center justify-center font-mono font-bold text-sm text-white shadow-lg shadow-sky-500/20">
        MG
      </span>
      <div class="flex flex-col">
        <span class="font-semibold text-sm text-slate-100 group-hover:text-sky-400 transition-colors">
          {DEVELOPER_PROFILE.fullName}
        </span>
        <span class="text-[11px] font-mono text-slate-400">DDD • Applied AI • MCP</span>
      </div>
    </a>

    <nav class="hidden md:flex items-center gap-6 text-sm text-slate-300 font-medium">
      <a href="#projects" class="hover:text-sky-400 transition-colors">Featured Projects</a>
      <a href="#playground" class="hover:text-sky-400 transition-colors flex items-center gap-1.5">
        <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
        Live Playground
      </a>
      <a href="#tech-radar" class="hover:text-sky-400 transition-colors">Tech Radar</a>
      <a href="#contact" class="hover:text-sky-400 transition-colors">Contact</a>
    </nav>

    <div class="flex items-center gap-3">
      <a
        href={DEVELOPER_PROFILE.githubUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="px-3 py-1.5 rounded-lg bg-slate-800/90 hover:bg-slate-700 text-slate-200 text-xs font-mono border border-slate-700 transition-colors"
      >
        GitHub ↗
      </a>
      <a
        href="#contact"
        class="px-3.5 py-1.5 rounded-lg bg-sky-500 hover:bg-sky-400 text-slate-950 font-semibold text-xs transition-colors"
      >
        Hire / Contact
      </a>
    </div>
  </div>
</header>
