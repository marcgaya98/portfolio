---
import { DEVELOPER_PROFILE } from '../domain/portfolio-data';
---

<header class="sticky top-0 z-50 bg-[#090909]/95 backdrop-blur-md border-b border-neutral-800">
  <div class="max-w-6xl mx-auto border-x border-neutral-800 px-4 sm:px-6 h-14 flex items-center justify-between">
    <a href="#top" class="flex items-center gap-3 group">
      <span class="w-6 h-6 bg-[#FF4F00] text-[#090909] flex items-center justify-center font-mono font-bold text-xs tracking-tighter">
        MG
      </span>
      <div class="flex items-center gap-2 font-mono text-xs">
        <span class="font-bold tracking-tight text-[#EDEDED] group-hover:text-[#FF4F00] transition-colors uppercase">
          {DEVELOPER_PROFILE.fullName}
        </span>
        <span class="hidden sm:inline text-neutral-600">//</span>
        <span class="hidden sm:inline text-neutral-400">DDD • APPLIED AI • MCP</span>
      </div>
    </a>

    <nav class="hidden md:flex items-center gap-6 text-xs font-mono text-neutral-400">
      <a href="#projects" class="hover:text-[#EDEDED] transition-colors">
        <span class="text-neutral-600">01.</span> SYSTEMS
      </a>
      <a href="#playground" class="hover:text-[#EDEDED] transition-colors flex items-center gap-1.5">
        <span class="w-1.5 h-1.5 bg-[#FF4F00]"></span>
        <span class="text-neutral-600">02.</span> PLAYGROUND
      </a>
      <a href="#tech-radar" class="hover:text-[#EDEDED] transition-colors">
        <span class="text-neutral-600">03.</span> ARCHITECTURE
      </a>
      <a href="#contact" class="hover:text-[#EDEDED] transition-colors">
        <span class="text-neutral-600">04.</span> CONTACT
      </a>
    </nav>

    <div class="flex items-center gap-2.5">
      <a
        href={DEVELOPER_PROFILE.githubUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="px-3 py-1.5 bg-[#0E0E0E] hover:bg-neutral-800 text-neutral-200 text-xs font-mono border border-neutral-800 transition-colors inline-flex items-center gap-1.5"
      >
        <span>GITHUB</span>
        <svg class="w-3 h-3 text-neutral-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M7 17L17 7M17 7H7M17 7V17" />
        </svg>
      </a>
      <a
        href="#contact"
        class="px-3.5 py-1.5 bg-[#EDEDED] hover:bg-[#FF4F00] text-[#090909] font-mono font-bold text-xs transition-colors"
      >
        CONTACT_
      </a>
    </div>
  </div>
</header>
