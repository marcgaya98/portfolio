---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import HeroSection from '../components/HeroSection.astro';
import FeaturedProjectsGrid from '../components/FeaturedProjectsGrid.astro';
import InteractivePlayground from '../components/InteractivePlayground';
import TechStackRadar from '../components/TechStackRadar';
import ContactSection from '../components/ContactSection';
import { DEVELOPER_PROFILE } from '../domain/portfolio-data';
---

<BaseLayout>
  <Navbar />

  <main class="flex-1">
    <HeroSection />
    <FeaturedProjectsGrid />
    <InteractivePlayground client:load />
    <TechStackRadar client:visible />
    <ContactSection client:visible />
  </main>

  <footer class="bg-[#090909] text-xs font-mono text-neutral-500">
    <div class="max-w-6xl mx-auto border-x border-neutral-800 px-4 sm:px-6 py-6 flex flex-col sm:flex-row items-center justify-between gap-4">
      <div class="flex items-center gap-2">
        <span class="w-2 h-2 bg-[#FF4F00]"></span>
        <span>© {new Date().getFullYear()} {DEVELOPER_PROFILE.fullName} // ASTRO 5 • REACT 19 • GEIST BLUEPRINT</span>
      </div>
      <div class="flex items-center gap-5">
        <a href={DEVELOPER_PROFILE.githubUrl} target="_blank" rel="noopener noreferrer" class="hover:text-[#FF4F00] transition-colors">
          GITHUB ↗
        </a>
        <a href={DEVELOPER_PROFILE.linkedinUrl} target="_blank" rel="noopener noreferrer" class="hover:text-[#FF4F00] transition-colors">
          LINKEDIN ↗
        </a>
        <a href={`mailto:${DEVELOPER_PROFILE.email}`} class="hover:text-[#FF4F00] transition-colors">
          {DEVELOPER_PROFILE.email}
        </a>
      </div>
    </div>
  </footer>
</BaseLayout>
